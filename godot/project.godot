; Projet Godot de NavalSim. Le code de jeu vit dans godot/scripts ; tout ce qui
; est arithmetique pure vit dans core/NavalSim.Core, qui ne reference PAS Godot
; et se teste donc sans lancer le moteur.

config_version=5

[application]
config/name="NavalSim"
config/description="Simulation navale - portage Godot"
run/main_scene="res://scenes/ship.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
; LE NOIR DU JEU DÈS LA PREMIÈRE SECONDE. Godot montre son écran de
; démarrage pendant qu il s initialise — deux secondes et quart, mesurées —
; puis le rideau de ShipDemo prend la suite jusqu à la première image. Même
; noir pour les deux, et l écran ne saute pas.
boot_splash/bg_color=Color(0.02, 0.03, 0.04, 1)
boot_splash/show_image=false

[dotnet]
project/assembly_name="NavalSim"

[rendering]
renderer/rendering_method="forward_plus"

[rendering]

; ANTICRÉNELAGE, et ce n'est pas du confort dans ce projet.
;
; Trois choses ici sont des pièges d'aliasing connus, tous consignés : les
; étoiles plus étroites qu'un pixel, les rides de la mer contre la taille de
; maille, et les cordages — dont le projet dit qu'un `THREE.Line` fait un pixel
; de large et scintille à toute distance qui vaille. La réponse GÉOMÉTRIQUE est
; d'être plus large que le pas d'échantillonnage ; celle-ci est l'autre moitié.
;
; MSAA 4x prend les bords de géométrie : les mâts, la silhouette de coque, et
; les rubans de cordage quand ils arriveront. FXAA prend ce que MSAA ne voit pas,
; c'est-à-dire le scintillement né DANS le fragment — le spéculaire de la mer et
; les crêtes d'écume. Les deux sont complémentaires et ne se remplacent pas.
;
; TAA est laissé ÉTEINT : c'est le vrai remède au scintillement spéculaire, mais
; il travaille en réutilisant l'image précédente, et une mer qui défile sous une
; caméra qui suit le navire est exactement le cas où cela traîne. À rallumer si
; le scintillement gêne plus que le fantôme.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false

[shader_globals]

; LE CIEL DES SHADERS QUI LE PRENNENT EN GLOBAL (#define NAVAL_SKY_GLOBAL : la
; coque, sa passe de brume, la toile, les cordages en rubans). SkyNode.PushGlobals
; les écrit une fois par image ; ces valeurs ne servent qu avant la première, et
; ce sont celles de sky.gdshaderinc et haze.gdshaderinc.
u_sun={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
u_zenith={
"type": "vec3",
"value": Vector3(0.12, 0.36, 0.52)
}
u_horizon={
"type": "vec3",
"value": Vector3(0.82, 0.89, 0.93)
}
u_cloud={
"type": "float",
"value": 0.12
}
u_sky_time={
"type": "float",
"value": 0.0
}
u_storm={
"type": "float",
"value": 0.0
}
u_storm_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
u_storm_loom={
"type": "float",
"value": 0.0
}
u_storm_flash_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
u_storm_flash={
"type": "float",
"value": 0.0
}
u_haze={
"type": "float",
"value": 0.00085
}
u_haze_h={
"type": "float",
"value": 150.0
}
u_sun_col={
"type": "vec3",
"value": Vector3(1, 0.95, 0.86)
}
